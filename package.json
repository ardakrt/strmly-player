{
  "name": "strmly",
  "private": true,
  "version": "1.8.1",
  "description": "Strmly is a desktop IPTV player.",
  "license": "MIT",
  "homepage": "https://github.com/ardakrt/strmly-player",
  "author": {
    "name": "Arda",
    "email": "ardakrt@users.noreply.github.com"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "shell-quote": "^1.8.4",
    "tar": "^7.5.16"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "typecheck:unused": "tsc -p tsconfig.app.json --noUnusedLocals true --noUnusedParameters true --noEmit",
    "test:migration": "node scripts/test-migration.js",
    "test:catalog": "node scripts/test-catalog-filters.js",
    "test:regressions": "node scripts/test-regressions.js",
    "check:a11y": "node scripts/check-a11y-controls.js",
    "test:security": "node scripts/test-security.js",
    "test:performance": "node scripts/test-performance.js",
    "verify": "npm run lint && npm run typecheck:unused && npm run test:migration && npm run test:security && npm run test:catalog && npm run test:regressions && npm run check:a11y && npm run build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ogl": "^1.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.strmly.iptv",
    "productName": "Strmly",
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "ardakrt",
        "repo": "strmly-player"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg-static",
        "filter": [
          "ffmpeg*",
          "*.LICENSE",
          "*.README",
          "package.json"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Strmly",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "executableName": "strmly",
      "icon": "build/icon.png",
      "maintainer": "Arda <ardakrt@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "artifactName": "Strmly-${version}-linux-${arch}.${ext}",
      "desktop": {
        "Name": "Strmly",
        "Comment": "Desktop IPTV player",
        "Categories": "AudioVideo;Video;Player;"
      }
    },
    "deb": {
      "depends": [
        "ffmpeg",
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    }
  }
}
